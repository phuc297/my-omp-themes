{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue235 {{ if .Venv }}({{ .Venv }}){{ end }} ",
          "foreground": "#82d3ff",
          "type": "python",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " {{ reason .Code }} ",
          "foreground": "#CB4B16",
          "type": "status",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \uf0e7 ",
          "foreground": "#CECE04",
          "type": "root",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ .UserName }}@{{ .HostName }} ",
          "foreground": "#FFFFFF",
          "type": "session",
          "style": "plain"
        },
        {
          "foreground": "#FFFFFF",
          "properties": {
            "style": "folder"
          },
          "style": "plain",
          "template": "\uf115 {{ .Path }} ",
          "type": "path"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "<#ffffff>git:</>{{ .HEAD }} ",
          "foreground": "#C1C106",
          "type": "git",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "<#CB4B16>❯</><#CACA02>❯</><#4E9A06>❯</> ",
          "foreground": "#ffffff",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 3
}